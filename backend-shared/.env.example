POSTGRES_USER=kevaks
POSTGRES_PASSWORD=kevaks
POSTGRES_DB=kevaks
POSTGRES_PORT=5432
DATABASE_URL=postgres://kevaks:kevaks@localhost:5432/kevaks?sslmode=disable

# LiveKit API key pair shared by the livekit server and the app.
# Generate a pair with: docker run --rm livekit/livekit-server generate-keys
# The secret must be at least 32 characters or LiveKit refuses to start.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-random-string-of-32-chars-min
LIVEKIT_NODE_IP=203.0.113.10        # the public IP the A record points at
LIVEKIT_CLIENT_URL=wss://lk.kevaks.com